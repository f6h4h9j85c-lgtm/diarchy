{
  "name": "diarchy",
  "version": "0.1.0",
  "description": "Two AI coding agents (Claude Code and Codex), each running as a product manager, coordinating PM-to-PM through an Obsidian vault with a protocol enforced in code.",
  "type": "module",
  "license": "MIT",
  "author": "Samuel Sullivan",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "diarchy": "./bin/diarchy.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "skills",
    "agents",
    "hooks",
    "docs",
    ".claude-plugin",
    ".agents",
    ".codex",
    ".mcp.json",
    "README.md",
    "LICENSE",
    "plugin.json",
    "mcp.json",
    "templates",
    "scripts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx src/cli/index.ts",
    "sync-skills": "node scripts/sync-skills.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^14.0.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.12"
  }
}
